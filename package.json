{
  "private": true,
  "license": "UNLICENSED",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @starter/web dev",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix",
    "storybook": "yarn workspace @starter/design-system storybook",
    "taze": "yarn dlx taze -r -I --maturity-period 3",
    "typecheck": "yarn workspaces foreach -p -A run typecheck"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.93.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "packageManager": "yarn@4.18.1"
}
