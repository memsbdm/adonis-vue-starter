{
  "name": "@starter/web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./app/core/*.js",
    "#identity/*": "./app/identity/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --project inertia/tsconfig.json"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.5",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.4",
    "@inertiajs/core": "^3.11.0",
    "@inertiajs/vue3": "catalog:",
    "@starter/design-system": "workspace:*",
    "@tuyau/core": "^1.3.0",
    "@vinejs/vine": "^4.4.0",
    "@vue/server-renderer": "^3.5.45",
    "better-sqlite3": "^13.0.3",
    "edge.js": "^6.5.1",
    "lucide-vue-next": "^1.0.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@tailwindcss/vite": "catalog:",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.6",
    "@vitejs/plugin-vue": "catalog:",
    "hot-hook": "^1.1.0",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "^3.3.14",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
